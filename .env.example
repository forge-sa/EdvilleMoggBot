# Token from @BotFather. Inline mode must be switched on there too: /setinline
BOT_TOKEN=

# Top of the GPA scale students enter their GPA on (5 or 4).
GPA_MAX=5

# Timezone used for "today" when checking dates and school years.
TIMEZONE=UTC

# Where the SQLite file lives.
DB_PATH=./data/moggmeter.db

# Comma-separated Telegram ids with the developer flag.
DEV_IDS=8964334068

# Edvies Mini App (collection + shop inside Telegram). Telegram only opens
# Mini Apps over HTTPS: point a domain or a tunnel at WEBAPP_PORT and put its
# public address here. Leave empty to run without the Mini App.
WEBAPP_URL=
WEBAPP_PORT=8080
